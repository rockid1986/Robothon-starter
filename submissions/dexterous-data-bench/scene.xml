            <geom name="pinky_distal_phalanx" type="capsule" fromto="0 -0.032 0.049 0 -0.006 0.015" size="0.011" material="phalanx_mat" contype="0" conaffinity="0"/>
            <geom name="pinky_tip" type="sphere" size="0.020" material="tip_mat" mass="0.035"/>
            <geom name="pinky_nail" type="box" pos="0 0.012 0.015" size="0.009 0.004 0.005" material="nail_mat" contype="0" conaffinity="0"/>
            <site name="pinky_tip_site" type="sphere" size="0.010" rgba="0.95 0.95 1 0.55"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="thumb_x_act" joint="thumb_x" ctrlrange="-0.075 0.075"/>
    <position name="thumb_y_act" joint="thumb_y" ctrlrange="-0.020 0.220"/>
    <position name="thumb_z_act" joint="thumb_z" ctrlrange="-0.155 0.020"/>
    <position name="index_x_act" joint="index_x" ctrlrange="-0.075 0.075"/>
    <position name="index_y_act" joint="index_y" ctrlrange="-0.020 0.220"/>
    <position name="index_z_act" joint="index_z" ctrlrange="-0.155 0.020"/>
    <position name="middle_x_act" joint="middle_x" ctrlrange="-0.075 0.075"/>
    <position name="middle_y_act" joint="middle_y" ctrlrange="-0.020 0.220"/>
    <position name="middle_z_act" joint="middle_z" ctrlrange="-0.155 0.020"/>
    <position name="ring_x_act" joint="ring_x" ctrlrange="-0.075 0.075"/>
    <position name="ring_y_act" joint="ring_y" ctrlrange="-0.020 0.220"/>
    <position name="ring_z_act" joint="ring_z" ctrlrange="-0.155 0.020"/>
    <position name="pinky_x_act" joint="pinky_x" ctrlrange="-0.075 0.075"/>
    <position name="pinky_y_act" joint="pinky_y" ctrlrange="-0.020 0.220"/>
    <position name="pinky_z_act" joint="pinky_z" ctrlrange="-0.155 0.020"/>
  </actuator>

  <sensor>
    <jointpos name="button_a_depth" joint="button_a_slide"/>
    <jointpos name="button_b_depth" joint="button_b_slide"/>
    <jointpos name="button_c_depth" joint="button_c_slide"/>
    <jointpos name="button_d_depth" joint="button_d_slide"/>
    <jointpos name="dial_angle" joint="dial_hinge"/>
    <touch name="button_a_touch" site="button_a_touch_site"/>
    <touch name="button_b_touch" site="button_b_touch_site"/>
    <touch name="button_c_touch" site="button_c_touch_site"/>
    <touch name="button_d_touch" site="button_d_touch_site"/>
    <framepos name="thumb_tip_pos" objtype="site" objname="thumb_tip_site"/>
    <framepos name="index_tip_pos" objtype="site" objname="index_tip_site"/>
    <framepos name="middle_tip_pos" objtype="site" objname="middle_tip_site"/>
    <framepos name="ring_tip_pos" objtype="site" objname="ring_tip_site"/>
    <framepos name="pinky_tip_pos" objtype="site" objname="pinky_tip_site"/>
  </sensor>
</mujoco>
